{
  "name": "@better-translation/example-svelte-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host",
    "build": "bun --cwd ../.. --filter better-translation build && vp build",
    "preview": "vp preview --host",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json && tsc --noEmit"
  },
  "dependencies": {
    "better-translation": "workspace:*",
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@better-translation/tsconfig": "workspace:*",
    "@sveltejs/adapter-auto": "^8.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@typescript/native": "catalog:",
    "svelte-check": "^4.7.8",
    "typescript": "6.0.3",
    "vite": "catalog:"
  },
  "portless": "svelte-kit.bt"
}
