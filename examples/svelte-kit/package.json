{
  "name": "@better-translation/example-svelte-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "bun --cwd ../.. --filter better-translation build && vite build",
    "preview": "vite preview --host",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json && tsc --noEmit"
  },
  "dependencies": {
    "better-translation": "workspace:*",
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@better-translation/tsconfig": "workspace:*",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@typescript/native": "catalog:",
    "svelte-check": "^4.7.4",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "portless": "svelte-kit.bt"
}
