{
  "name": "@better-translation/root",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "examples/*",
      "packages/*",
      "tooling/*"
    ],
    "catalog": {
      "@base-ui/react": "1.9.0",
      "@neondatabase/serverless": "1.2.0",
      "@sveltejs/vite-plugin-svelte": "7.3.1",
      "@tailwindcss/vite": "4.3.5",
      "@tanstack/devtools-event-client": "0.5.1",
      "@tanstack/devtools-vite": "0.8.6",
      "@tanstack/match-sorter-utils": "9.2.6",
      "@tanstack/query-db-collection": "1.5.2",
      "@tanstack/react-pacer": "0.24.1",
      "@tanstack/react-db": "1.0.0-rc.1.5",
      "@tanstack/react-devtools": "0.10.14",
      "@tanstack/react-form": "2.0.0-alpha.3",
      "@tanstack/react-query": "5.107.1",
      "@tanstack/react-router-devtools": "1.167.3",
      "@tanstack/react-router-ssr-query": "1.167.3",
      "@tanstack/react-router": "1.170.46",
      "@tanstack/react-start": "1.169.5",
      "@tanstack/react-store": "0.11.2",
      "@tanstack/react-table": "9.3.1",
      "@tanstack/router-plugin": "1.169.0",
      "@tanstack/store": "0.11.2",
      "@types/bun": "1.4.4",
      "@types/node": "26.6.6",
      "@types/react-dom": "19.3.0",
      "@types/react": "19.3.0",
      "@typescript/native": "npm:typescript@7.0.2",
      "@vercel/functions": "3.11.1",
      "@vitejs/plugin-react": "6.3.0",
      "ai": "7.0.170",
      "better-auth": "1.7.21",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "dotenv-cli": "11.1.0",
      "dotenv": "17.4.2",
      "jsdom": "31.0.0",
      "lucide-react": "1.72.0",
      "nitro": "3.0.261103-rc",
      "react-dom": "19.3.1",
      "react": "19.3.1",
      "sonner": "2.0.8",
      "superjson": "2.2.6",
      "svelte": "5.57.3",
      "tailwind-merge": "3.7.0",
      "tailwindcss": "4.3.5",
      "tw-animate-css": "1.4.0",
      "typescript": "7.0.2",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
      "zod": "4.6.7",
      "vite-plus": "1.6.0"
    }
  },
  "type": "module",
  "scripts": {
    "bench:performance": "bun --filter better-translation bench:performance",
    "bench:performance:compare": "bun packages/better-translation/bench/compare-performance.ts",
    "bench:performance:guard": "bun --filter better-translation bench:performance:guard",
    "bench:performance:json": "bun packages/better-translation/bench/performance.bench.ts --json",
    "build:packages": "bun --filter better-translation build",
    "changeset": "changeset",
    "lint": "vp lint",
    "format": "vp fmt",
    "fix": "vp lint --fix && vp fmt",
    "test": "bun test && bun run test:types && bun run bench:performance:guard",
    "test:types": "bun --filter better-translation test:types",
    "check": "vp check",
    "check:publish": "bun run build:packages && vp check packages/better-translation",
    "video:preview": "bun --cwd apps/promo-video dev",
    "video:render": "bun --cwd apps/promo-video render",
    "video:render:teasers": "bun --cwd apps/promo-video render:teasers",
    "version-packages": "changeset version && bun install",
    "release": "bun run build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@tsdown/css": "^0.23.7",
    "@typescript/native": "catalog:",
    "better-translation": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
