      "@tanstack/react-start": "1.168.34",
      "@tanstack/react-store": "0.11.0",
      "@tanstack/react-table": "8.21.3",
      "@tanstack/router-plugin": "1.168.23",
      "@tanstack/store": "0.11.0",
      "@types/bun": "1.3.14",
      "@types/node": "26.1.2",
      "@types/react-dom": "19.2.4",
      "@types/react": "19.2.18",
      "@typescript/native": "npm:typescript@7.0.2",
      "@vercel/functions": "3.7.6",
      "@vitejs/plugin-react": "6.0.5",
      "ai": "7.0.44",
      "better-auth": "1.6.25",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "dotenv-cli": "11.0.0",
      "dotenv": "17.4.2",
      "jsdom": "30.0.1",
      "lucide-react": "1.28.0",
      "nitro": "3.0.260610-beta",
      "react-dom": "19.2.8",
      "react": "19.2.8",
      "sonner": "2.0.7",
      "superjson": "2.2.6",
      "svelte": "5.56.8",
      "tailwind-merge": "3.6.0",
      "tailwindcss": "4.3.3",
      "tw-animate-css": "1.4.0",
      "typescript": "6.0.3",
      "vite": "8.2.0",
      "zod": "4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "bench:performance": "bun --filter better-translation bench:performance",
    "bench:performance:compare": "bun packages/better-translation/bench/compare-performance.ts",
    "bench:performance:guard": "bun --filter better-translation bench:performance:guard",
    "bench:performance:json": "bun packages/better-translation/bench/performance.bench.ts --json",
    "build:packages": "bun --filter better-translation build",
    "changeset": "changeset",
    "lint": "vp lint",
    "format": "vp fmt",
    "fix": "vp lint --fix && vp fmt",
    "test": "bun test && bun run test:types && bun run bench:performance:guard",
    "test:types": "bun --filter better-translation test:types",
    "check": "vp check",
    "check:publish": "bun run build:packages && vp check packages/better-translation",
    "version-packages": "changeset version && bun install",
    "release": "bun run build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^2.31.1",
    "@tsdown/css": "^0.22.14",
    "@typescript/native": "catalog:",
    "better-translation": "workspace:*",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "catalog:",
    "vite-plus": "0.2.9"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
