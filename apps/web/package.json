{
  "name": "@better-translation/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun with-env vite dev --host",
    "build": "bun --cwd ../.. --filter better-translation build && bun with-env vite build",
    "start": "node .output/server/index.mjs",
    "lint": "vp lint",
    "format": "vp fmt",
    "fix": "vp lint --fix && vp fmt",
    "check": "vp check",
    "db:generate": "bun with-env drizzle-kit generate",
    "db:migrate": "bun with-env drizzle-kit migrate",
    "db:push": "bun with-env drizzle-kit push",
    "db:pull": "bun with-env drizzle-kit pull",
    "db:studio": "bun with-env drizzle-kit studio",
    "with-env": "dotenv -e ../../.env.local --"
  },
