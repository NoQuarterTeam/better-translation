  "scripts": {
    "dev": "bun with-env vite dev --host",
    "build": "bun --cwd ../.. --filter better-translation build && bun with-env vite build",
    "start": "node .output/server/index.mjs",
    "lint": "vp lint",
    "format": "vp fmt",
    "fix": "vp lint --fix && vp fmt",
