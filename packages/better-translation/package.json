{
  "name": "better-translation",
  "version": "0.2.6",
  "description": "Vite plugin and runtime helpers for Better Translation.",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoQuarterTeam/better-translation.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./vite": {
      "import": "./dist/vite.mjs",
      "types": "./dist/vite.d.mts"
    },
    "./react": {
      "import": "./dist/react.mjs",
      "types": "./dist/react.d.mts"
    },
    "./server": {
      "import": "./dist/server.mjs",
      "types": "./dist/server.d.mts"
    },
    "./ai": {
      "import": "./dist/ai.mjs",
      "types": "./dist/ai.d.mts"
    },
    "./messages": {
      "import": "./dist/messages.mjs",
      "types": "./dist/messages.d.mts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && vite build",
    "prepack": "bun run build"
  },
  "dependencies": {
    "ai": "6.0.197",
    "oxc-parser": "0.134.0"
  },
  "devDependencies": {
    "@better-translation/locale-editor": "workspace:*",
    "@better-translation/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
