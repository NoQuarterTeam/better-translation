{
  "name": "better-translation",
  "version": "0.6.8",
  "description": "Local-first Vite i18n plugin for React and Svelte that turns source copy into flat Locale value JSON, with optional AI translation.",
  "keywords": [
    "ai-translation",
    "i18n",
    "internationalization",
    "localization",
    "react",
    "svelte",
    "tanstack",
    "translation",
    "typescript",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://www.better-translation.dev",
  "bugs": {
    "url": "https://github.com/NoQuarterTeam/better-translation/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoQuarterTeam/better-translation.git",
    "directory": "packages/better-translation"
  },
  "bin": {
    "better-translation": "./dist/cli.mjs",
    "bt": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./vite": {
      "import": "./dist/vite.mjs",
      "types": "./dist/vite.d.mts"
    },
    "./react": {
      "import": "./dist/react.mjs",
      "types": "./dist/react.d.mts"
    },
    "./runtime": {
      "import": "./dist/runtime.mjs",
      "types": "./dist/runtime.d.mts"
    },
    "./svelte": {
      "import": "./dist/svelte.mjs",
      "types": "./dist/svelte.d.mts"
    },
    "./ai": {
      "import": "./dist/ai.mjs",
      "types": "./dist/ai.d.mts"
    },
    "./messages": {
      "import": "./dist/messages.mjs",
      "types": "./dist/messages.d.mts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench:performance": "bun run bench/performance.bench.ts",
    "bench:performance:compare": "bun run bench/compare-performance.ts",
    "bench:performance:guard": "bun run bench/performance.bench.ts --guard",
    "bench:performance:json": "bun run bench/performance.bench.ts --json",
    "build": "vp pack && vite build",
    "prepack": "bun run build",
    "test": "bun test && bun run bench:performance:guard",
    "test:types": "vp pack && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "ai": "7.0.77",
    "oxc-parser": "0.146.0"
  },
  "devDependencies": {
    "@better-translation/locale-editor": "workspace:*",
    "@better-translation/tsconfig": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "mitata": "^1.0.34",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@sveltejs/vite-plugin-svelte": ">=7",
    "react": ">=19",
    "react-dom": ">=19",
    "svelte": ">=5",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@sveltejs/vite-plugin-svelte": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
