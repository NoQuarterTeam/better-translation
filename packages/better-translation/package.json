{
  "name": "better-translation",
  "version": "0.4.2",
  "description": "Vite plugin and runtime helpers for Better Translation.",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoQuarterTeam/better-translation.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./vite": {
      "import": "./dist/vite.mjs",
      "types": "./dist/vite.d.mts"
    },
    "./react": {
      "import": "./dist/react.mjs",
      "types": "./dist/react.d.mts"
    },
    "./runtime": {
      "import": "./dist/runtime.mjs",
      "types": "./dist/runtime.d.mts"
    },
    "./svelte": {
      "import": "./dist/svelte.mjs",
      "types": "./dist/svelte.d.mts"
    },
    "./ai": {
      "import": "./dist/ai.mjs",
      "types": "./dist/ai.d.mts"
    },
    "./messages": {
      "import": "./dist/messages.mjs",
      "types": "./dist/messages.d.mts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && vite build",
    "prepack": "bun run build"
  },
  "dependencies": {
    "ai": "7.0.7",
    "oxc-parser": "0.137.0"
  },
  "devDependencies": {
    "@better-translation/locale-editor": "workspace:*",
    "@better-translation/tsconfig": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "svelte": "^5.56.2",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@sveltejs/vite-plugin-svelte": ">=7",
    "react": ">=19",
    "react-dom": ">=19",
    "svelte": ">=5",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@sveltejs/vite-plugin-svelte": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
